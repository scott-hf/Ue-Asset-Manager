<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.5"/>
  <template class="EpicAssetPicker" parent="AdwDialog">
    <property name="title" translatable="yes">Choose assets</property>
    <property name="content-width">680</property>
    <property name="content-height">660</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-end-title-buttons">false</property>
            <property name="show-start-title-buttons">false</property>
            <child type="start">
              <object class="GtkButton" id="cancel_button">
                <property name="label" translatable="yes">Cancel</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="import_button">
                <property name="label" translatable="yes">Import selection</property>
                <property name="css-classes">suggested-action</property>
                <property name="sensitive">false</property>
              </object>
            </child>
          </object>
        </child>
        <child type="top">
          <object class="AdwBanner" id="warning_banner">
            <property name="revealed">false</property>
          </object>
        </child>
        <property name="content">
          <object class="GtkStack" id="stack">
            <property name="vexpand">true</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">loading</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkSpinner" id="spinner">
                        <property name="spinning">true</property>
                        <property name="width-request">32</property>
                        <property name="height-request">32</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Reading the assets of this pack...</property>
                        <property name="css-classes">dim-label</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">list</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">4</property>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkSearchEntry" id="search_entry">
                            <property name="hexpand">true</property>
                            <property name="placeholder-text" translatable="yes">Search assets</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkDropDown" id="class_dropdown">
                            <property name="tooltip-text" translatable="yes">Filter by asset class</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkButton" id="select_shown_button">
                            <property name="label" translatable="yes">Select all shown</property>
                            <property name="css-classes">flat</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="clear_button">
                            <property name="label" translatable="yes">Clear selection</property>
                            <property name="css-classes">flat</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="vexpand">true</property>
                        <property name="hscrollbar-policy">never</property>
                        <property name="css-classes">card</property>
                        <property name="child">
                          <object class="GtkListView" id="list_view">
                            <property name="css-classes">rich-list</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">error</property>
                <property name="child">
                  <object class="AdwStatusPage" id="error_page">
                    <property name="icon-name">dialog-warning-symbolic</property>
                    <property name="title" translatable="yes">Unable to list the assets</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
        <child type="bottom">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">2</property>
            <property name="margin-start">16</property>
            <property name="margin-end">16</property>
            <property name="margin-top">8</property>
            <property name="margin-bottom">8</property>
            <child>
              <object class="GtkLabel" id="summary_label">
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="label" translatable="yes">Nothing selected</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="footer_label">
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <property name="visible">false</property>
                <property name="css-classes">caption dim-label</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
